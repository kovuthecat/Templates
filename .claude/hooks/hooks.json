{
  "_comment": "Câblage des hooks du plugin workflow. Reproduit project-settings.json (SessionStart / PreToolUse Bash|PowerShell / Stop) + un 4e hook PostToolUse (formatage prettier conditionnel). Chemins résolus via ${CLAUDE_PLUGIN_ROOT}, portables (cache local ou cloud).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/sessionstart-contexte.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pretooluse-git.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/posttooluse-format.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/stop-contexte.mjs\"",
            "timeout": 20,
            "statusMessage": "Vérification du contexte…"
          }
        ]
      }
    ]
  }
}
